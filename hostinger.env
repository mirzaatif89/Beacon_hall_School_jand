# Rename this file to .env after uploading it to your Hostinger Node.js app folder.
# Replace every value marked CHANGE_ME with the exact value from hPanel.

# MySQL database (hPanel > Databases > MySQL Databases)
DB_HOST=localhost
DB_NAME=CHANGE_ME_DATABASE_NAME
DB_USER=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_PORT=3306
AUTO_CREATE_DB=false

# Application security: use a long, unique random string.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Principal account
PRINCIPAL_USERNAME=principal@school.com
PRINCIPAL_PASSWORD=CHANGE_ME_STRONG_PRINCIPAL_PASSWORD

# Email settings (optional; leave blank if email features are not required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Beacon Lights School

# Optional integrations
SCHOOL_WEBSITE=https://yourdomain.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
