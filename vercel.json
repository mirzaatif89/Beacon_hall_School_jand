{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/website",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/website.html",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
